# Food Verse AI Environment Configuration
# Copy this file to .env and provide your optional keys

# Server
PORT=8000
HOST=127.0.0.1

# Database (Default is local SQLite)
DATABASE_URL=sqlite:///./foodverse.db

# Optional AI & Nutrition APIs (Leave empty to use genuine offline fallback engines)
GEMINI_API_KEY=
OPENAI_API_KEY=
USDA_API_KEY=
